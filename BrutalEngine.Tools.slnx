<Solution>
  <!--
    Build-time tools and their tests. Kept out of BrutalEngine.slnx so the engine's build and test jobs never restore
    the tools' natives (ADR-0012).
  -->
  <Folder Name="/tools/">
    <Project Path="tools/BrutalEngine.Cook/BrutalEngine.Cook.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/BrutalEngine.Cook.Tests/BrutalEngine.Cook.Tests.csproj" />
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="NuGet.config" />
    <File Path="tools/Directory.Build.props" />
  </Folder>
</Solution>
