<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Samples are runnable programs that ship with each milestone (docs/04-repo-layout.md). They are never packed, have
    no tracked public API, and keep every type internal.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Needed so IDE0005 (unnecessary usings) runs in the build. Internal types need no XML docs (CS1591 is public-only). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Samples don't ship XML docs, though. This keeps the sample's own XML file and its referenced projects' (for example
      BrutalEngine.Core.xml) out of the publish output: it sets both PublishDocumentationFile and
      PublishReferencesDocumentationFiles. CI checks the HelloWindow publish output has no *.xml file.
    -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>
</Project>
