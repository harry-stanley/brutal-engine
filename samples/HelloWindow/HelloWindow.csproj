<Project Sdk="Microsoft.NET.Sdk">
  <!--
    M0 sample: an SDL3 window presenting a Vulkan 1.3 clear-colour swapchain, written directly on BRUTAL's bindings
    (README.md). Runs with the JIT and as NativeAOT. Trim/AOT warnings are errors (TreatWarningsAsErrors), and
    TrimmerSingleWarn=false reports them per call site instead of one summary warning per assembly.
  -->
  <PropertyGroup>
    <AssemblyName>HelloWindow</AssemblyName>
    <RootNamespace>HelloWindow</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Listed so the lock file covers the NativeAOT compiler packages for every supported RID. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BrutalEngine.Core/BrutalEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.Brutal.Sdl" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HelloWindow.Tests" />
  </ItemGroup>

  <!--
    The official BRUTAL logo (BRUTAL/docs/branding/LOGO_BRUTAL_WHT.png, byte for byte), shown as the splash before the
    scene. BRUTAL LICENSE 2.2 requires it unaltered except for scaling.
  -->
  <ItemGroup>
    <Content Include="Assets/LOGO_BRUTAL_WHT.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    BRUTAL's licence duties for a product built on it, met next to the executable (nothing is vendored into the repo):
    - LICENSE 1.0: BRUTAL's copyright and permission notice ship with every copy, as LICENSE.txt.
    - LICENSE 2.1: BRUTAL's copyright notice appears in the credits. CREDITS.txt is generated at build time from that
      LICENSE.txt's copyright line and the repo LICENSE's copyright lines (BrutalEngine), so none is retyped.
    - LICENSE 2.3: NOTICE.txt ships alongside the product.
    - LICENSE 4.0: each package's LICENSES/ directory lists the third-party components it redistributes, with their
      licences.
    The packages have no contentFiles or build targets that would copy these, so collect them from the root of every
    BRUTAL package that contributes a runtime asset (managed or native, direct or transitive). Every package carries
    the same LICENSE.txt and NOTICE.txt; the build fails if any copy differs, rather than picking one silently.
  -->
  <Target Name="HelloWindowCollectBrutalLicenceFiles" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets">
    <ItemGroup>
      <_HelloWindowBrutalAsset Include="@(RuntimeCopyLocalItems);@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)"
                               Condition="$([System.String]::Copy('%(NuGetPackageId)').StartsWith('Ahwoo.Brutal.', System.StringComparison.OrdinalIgnoreCase))" />
      <!-- A restore graph holds one version per package, so the ID alone identifies the package. -->
      <_HelloWindowBrutalPackage Include="@(_HelloWindowBrutalAsset->'%(NuGetPackageId)'->Distinct())" />
      <_HelloWindowBrutalPackageRoot Include="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))$([System.String]::Copy('%(_HelloWindowBrutalPackage.Identity)').ToLowerInvariant())/%(_HelloWindowBrutalPackage.NuGetPackageVersion)/"
                                     PackageId="%(_HelloWindowBrutalPackage.Identity)" />
      <!-- Files every package ships once, identically; OutputName is their name in the output. -->
      <_HelloWindowBrutalSharedFile Include="%(_HelloWindowBrutalPackageRoot.Identity)NOTICE.txt" OutputName="NOTICE.txt" />
      <_HelloWindowBrutalSharedFile Include="%(_HelloWindowBrutalPackageRoot.Identity)LICENSE.txt" OutputName="LICENSE.txt" />
      <!-- One folder per package: packages ship different files under the same name (Sdl and Sdl.Native, for example). -->
      <_HelloWindowBrutalLicence Include="%(_HelloWindowBrutalPackageRoot.Identity)LICENSES/**/*" PackageId="%(_HelloWindowBrutalPackageRoot.PackageId)" />
    </ItemGroup>

    <Error Condition="'@(_HelloWindowBrutalPackage)' == ''" Text="No Ahwoo.Brutal package assets were resolved, so BRUTAL's licence files can't be collected." />
    <Error Condition="!Exists('%(_HelloWindowBrutalSharedFile.Identity)')" Text="BRUTAL package without %(_HelloWindowBrutalSharedFile.OutputName): %(_HelloWindowBrutalSharedFile.Identity)" />
    <GetFileHash Files="@(_HelloWindowBrutalSharedFile)">
      <Output TaskParameter="Items" ItemName="_HelloWindowBrutalSharedFileHash" />
    </GetFileHash>
    <ItemGroup>
      <_HelloWindowBrutalSharedFileVariant Include="@(_HelloWindowBrutalSharedFileHash->'%(OutputName)/%(FileHash)'->Distinct())" OutputName="%(OutputName)" />
    </ItemGroup>
    <!-- Batched by OutputName, so each check sees, and lists, only that file's copies with their hashes. -->
    <Error Condition="'%(OutputName)' != '' and @(_HelloWindowBrutalSharedFileVariant->Count()) != 1"
           Text="The BRUTAL packages' %(OutputName) files differ: @(_HelloWindowBrutalSharedFileHash->'%(Identity) (SHA-256 %(FileHash))', '; ')" />

    <ItemGroup>
      <_HelloWindowBrutalNotice Include="@(_HelloWindowBrutalSharedFile->WithMetadataValue('OutputName', 'NOTICE.txt'))" />
      <_HelloWindowBrutalLicense Include="@(_HelloWindowBrutalSharedFile->WithMetadataValue('OutputName', 'LICENSE.txt'))" />
    </ItemGroup>
    <!-- The copies are identical (checked above), so any one will do: batching leaves the last. -->
    <PropertyGroup>
      <_HelloWindowBrutalNoticeFile>%(_HelloWindowBrutalNotice.FullPath)</_HelloWindowBrutalNoticeFile>
      <_HelloWindowBrutalLicenseFile>%(_HelloWindowBrutalLicense.FullPath)</_HelloWindowBrutalLicenseFile>
    </PropertyGroup>
    <PropertyGroup>
      <_HelloWindowEngineLicenseFile>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../../LICENSE'))</_HelloWindowEngineLicenseFile>
      <_HelloWindowCreditsFile>$(IntermediateOutputPath)CREDITS.txt</_HelloWindowCreditsFile>
    </PropertyGroup>

    <!-- CREDITS.txt: the copyright lines, copied from the licences rather than retyped. -->
    <ReadLinesFromFile File="$(_HelloWindowBrutalLicenseFile)">
      <Output TaskParameter="Lines" ItemName="_HelloWindowBrutalLicenseLine" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_HelloWindowEngineLicenseFile)">
      <Output TaskParameter="Lines" ItemName="_HelloWindowEngineLicenseLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_HelloWindowBrutalCopyright Include="@(_HelloWindowBrutalLicenseLine)" Condition="$([System.String]::Copy('%(Identity)').Contains('is Copyright (c)'))" />
      <_HelloWindowEngineCopyright Include="@(_HelloWindowEngineLicenseLine)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('Copyright (c)'))" />
      <_HelloWindowEngineLicenseName Include="@(_HelloWindowEngineLicenseLine)" Condition="$([System.String]::Copy('%(Identity)').EndsWith(' License'))" />
    </ItemGroup>
    <Error Condition="@(_HelloWindowBrutalCopyright->Count()) != 1" Text="Expected one copyright line in $(_HelloWindowBrutalLicenseFile), found @(_HelloWindowBrutalCopyright->Count())." />
    <!-- BrutalEngine's LICENSE may name several copyright holders: credit every one. -->
    <Error Condition="@(_HelloWindowEngineCopyright->Count()) == 0 or @(_HelloWindowEngineLicenseName->Count()) != 1"
           Text="Expected one licence name and at least one copyright line in $(_HelloWindowEngineLicenseFile)." />
    <!-- One property, so blank lines survive (the text has no ';' to split it into items), with the platform's newlines. -->
    <PropertyGroup>
      <_HelloWindowNewLine>$([System.Environment]::NewLine)</_HelloWindowNewLine>
      <_HelloWindowCreditsText>HelloWindow, a BrutalEngine sample.$(_HelloWindowNewLine)$(_HelloWindowNewLine)</_HelloWindowCreditsText>
      <_HelloWindowCreditsText>$(_HelloWindowCreditsText)Built with BRUTAL:$(_HelloWindowNewLine)@(_HelloWindowBrutalCopyright)$(_HelloWindowNewLine)</_HelloWindowCreditsText>
      <_HelloWindowCreditsText>$(_HelloWindowCreditsText)BRUTAL's licence is in LICENSE.txt, its notice in NOTICE.txt, and the licences of the third-party components it redistributes in LICENSES/.$(_HelloWindowNewLine)$(_HelloWindowNewLine)</_HelloWindowCreditsText>
      <_HelloWindowCreditsText>$(_HelloWindowCreditsText)BrutalEngine (@(_HelloWindowEngineLicenseName)):$(_HelloWindowNewLine)@(_HelloWindowEngineCopyright, '$(_HelloWindowNewLine)')</_HelloWindowCreditsText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_HelloWindowCreditsFile)" Lines="$(_HelloWindowCreditsText)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(_HelloWindowCreditsFile)" />
      <None Include="$(_HelloWindowBrutalNoticeFile)" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(_HelloWindowBrutalLicenseFile)" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(_HelloWindowCreditsFile)" Link="CREDITS.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="@(_HelloWindowBrutalLicence)" Link="LICENSES/%(_HelloWindowBrutalLicence.PackageId)/%(_HelloWindowBrutalLicence.RecursiveDir)%(_HelloWindowBrutalLicence.Filename)%(_HelloWindowBrutalLicence.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
