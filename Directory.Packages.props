<Project>
  <!-- Central package management: every package version used anywhere in the repo is pinned here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Build tooling (src/) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!--
    Roslyn components. Microsoft.CodeAnalysis.CSharp stays at 5.0.0: the compiler in the pinned .NET 11 SDK (5.12)
    and in every .NET 10 SDK is at least that version, and an analyzer built against a newer Roslyn than the host
    compiler fails to load.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <!-- BRUTAL. All Ahwoo.Brutal.* packages move together in Dependabot's 'brutal' group. -->
  <ItemGroup>
    <PackageVersion Include="Ahwoo.Brutal.Sdl" Version="2026.10.3" />
    <!-- Offline shader compilation in tools/BrutalEngine.Cook only; never referenced by src/ (ADR-0012). -->
    <PackageVersion Include="Ahwoo.Brutal.Slang" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.Brutal.Vulkan" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.Brutal.Vulkan.Abstractions" Version="2026.10.3" />
    <!-- Transitive via Ahwoo.Brutal.Strings; ADR-0011. Remove when BRUTAL depends on a GA ObjectPool. -->
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="11.0.0" />
  </ItemGroup>

  <!-- Testing (tests/) -->
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
