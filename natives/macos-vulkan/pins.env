# Pinned macOS Vulkan natives (spike S1/S3, docs/spikes/README.md). Sourced by bash; keep KEY=value lines only.
# Bump a tag together with its commit (or SHA-256): the action asserts both, and the build cache is keyed on them.

# MoltenVK: official release asset. SHA-256 = the GitHub release asset digest (gh api .../releases/tags/<tag>).
MOLTENVK_TAG=v1.4.2
MOLTENVK_ASSET=MoltenVK-macos.tar
MOLTENVK_SHA256=f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e

# Vulkan loader: built from source (Khronos publishes no macOS binaries outside the LunarG SDK).
LOADER_TAG=vulkan-sdk-1.4.363.0
LOADER_COMMIT=fa218055ff4948b159f31d43f800c808a13d51df

# Khronos validation layers: built from source, test-only (never shipped in games).
VALIDATION_LAYERS_TAG=vulkan-sdk-1.4.363.1
VALIDATION_LAYERS_COMMIT=317cff060893783f96d4174f50491e6374eb3714
