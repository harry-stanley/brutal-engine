# Normalise all text files to LF in the repository and the working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never diff or normalise.
*.png  binary
*.jpg  binary
*.ktx2 binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.ogg  binary
*.dll  binary
*.so   binary
*.dylib binary

# Large binary assets for golden-image tests and samples are stored with Git LFS
# (patterns are added here as those folders are created, see docs/04-repo-layout.md).
