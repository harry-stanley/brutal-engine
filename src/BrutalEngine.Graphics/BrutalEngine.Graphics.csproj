<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>BrutalEngine render interface: the backend-neutral GPU API (typed GPU object handles first) that every graphics backend implements.</Description>
    <PackageTags>gamedev;game-engine;2d;brutal;graphics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../BrutalEngine.Core/BrutalEngine.Core.csproj" />
  </ItemGroup>

  <!--
    Properties/AssemblyInfo.cs declares both InternalsVisibleTo attributes (the test project and the conformance suite),
    each with its reason, so the inherited item from src/Directory.Build.props is removed to avoid a duplicate.
  -->
  <ItemGroup>
    <InternalsVisibleTo Remove="BrutalEngine.Graphics.Tests" />
  </ItemGroup>
</Project>
