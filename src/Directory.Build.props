<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Roslyn components (analyzers, source generators) live under src/ but are build-time tools: they target
    netstandard2.0, aren't AOT-compiled, have no tracked public API, and aren't packed yet.
  -->
  <PropertyGroup>
    <IsRoslynComponentProject Condition="$(MSBuildProjectName.EndsWith('.Analyzers')) or $(MSBuildProjectName.EndsWith('.Generators'))">true</IsRoslynComponentProject>
  </PropertyGroup>

  <!--
    Every supported RID in each lock file. An app that references a src module and is published for a RID (HelloWindow,
    as NativeAOT) restores that module for the RID too, and CI's locked restore fails (NU1004) unless the module's lock
    file already covers it. Roslyn components included: Core restores BrutalEngine.Analyzers as part of its graph.
    Only RuntimeIdentifiers (plural) is set, which adds RID sections to the lock file and changes nothing else: builds
    and packages stay RID-agnostic.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    The ship gate (ADR-0016): the milestone the next release ships. A library packs only when its csproj's
    BrutalEngineMilestone is at most this (src/Directory.Build.targets). The PR that follows each release tag raises it
    by one: 1 until v0.2.0 is tagged, then 2.
  -->
  <PropertyGroup>
    <BrutalEngineReleaseMilestone>1</BrutalEngineReleaseMilestone>
  </PropertyGroup>

  <!-- Shipped engine libraries: one project = one NuGet package (docs/04-repo-layout.md). -->
  <PropertyGroup Condition="'$(IsRoslynComponentProject)' != 'true'">
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>$(MSBuildProjectName)</PackageId>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/harry-stanley/brutal-engine</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>

    <!--
      Versions come from git tags (vX.Y.Z). Untagged commits are 0.2.0-alpha.0.N until v0.2.0.
      MinVer raises an untagged commit's version to this minimum when it is lower (after v0.1.0-alpha it would be 0.1.0-alpha.N).
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.2</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsRoslynComponentProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- Our own analyzers (BE1xxx) run on every engine library. Build-time only: nothing is referenced at runtime. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)BrutalEngine.Analyzers/BrutalEngine.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Every package carries the README, and BRUTAL's NOTICE.txt (required by the BRUTAL License v1.0). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../NOTICE.txt" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Public API tracking (RS0016/RS0017): each project keeps PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
  </ItemGroup>

  <!-- Only the matching test project may see internals (docs/07-coding-standards.md). -->
  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>
</Project>
