<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Background (concurrent) garbage collection off, so the allocation tests measure exactly. When a background
    collection ends its mark phase, the .NET 10 runtime voids every thread's allocation context without taking
    the unused tail off that thread's count, so GC.GetAllocatedBytesForCurrentThread jumps by up to a few KB on a
    thread that allocated nothing. Tests running in parallel cause such collections (large-object allocations
    start them). Blocking collections count correctly, and this setting doesn't change what the code under test
    allocates. AllocationMeasurementTests guards it; docs/05-testing-strategy.md, "Allocation tests", explains it.
  -->
  <PropertyGroup>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BrutalEngine.Core/BrutalEngine.Core.csproj" />
  </ItemGroup>
</Project>
