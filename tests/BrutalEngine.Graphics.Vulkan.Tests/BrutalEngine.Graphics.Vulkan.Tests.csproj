<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Background (concurrent) garbage collection off, so the allocation tests measure exactly: a background collection
    voids every thread's allocation context without taking the unused tail off that thread's count
    (docs/05-testing-strategy.md, "Allocation tests"). AllocationMeasurementTests guards the setting.
  -->
  <PropertyGroup>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!--
    BRUTAL's SDL binding is test-only: the Gpu tests create a hidden SDL window for a real VkSurfaceKHR
    (docs/design/graphics-vulkan.md section 15). The backend itself never references SDL.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/BrutalEngine.Graphics.Vulkan/BrutalEngine.Graphics.Vulkan.csproj" />
    <PackageReference Include="Ahwoo.Brutal.Sdl" />
  </ItemGroup>
</Project>
